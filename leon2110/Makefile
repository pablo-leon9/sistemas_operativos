GCC = gcc -lm

PROGRAMAS = fork01 fork02 fork03 fork04 fork05 fork06

fork01:
	clear;$(GCC) $@.c -o $@ ;./$@

fork02:
	clear;$(GCC) $@.c -o $@ ;./$@

fork03:
	clear;$(GCC) $@.c -o $@ ;./$@

fork04:
	clear;$(GCC) $@.c -o $@ ;./$@

fork05:
	clear;$(GCC) $@.c -o $@ ;./$@

fork06:
	clear;$(GCC) $@.c -o $@ ;./$@

clear:
	clear;$(RM) $(PROGRAMAS);ls
